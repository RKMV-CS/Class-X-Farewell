/* ---------- fit to window ---------- */
function fit() {
  scale = Math.min(innerWidth / 1920, innerHeight / 1080);
  stage.style.transform = `translate(-50%,-50%) scale(${scale})`;
}
addEventListener('resize', fit); fit();

/* ---------- run control ---------- */
const CANCEL = { cancelled: true };
let runId = 0;
const wait = ms => { const id = runId; return new Promise((res, rej) => setTimeout(() => id === runId ? res() : rej(CANCEL), ms)); };
function snap(fn) {
  stage.classList.add('snap');
  if (typeof Animation !== 'undefined') document.getAnimations().forEach(a => {
    if (typeof CSSAnimation !== 'undefined' && (a instanceof CSSAnimation || a instanceof CSSTransition)) return;
    a.cancel();
  });
  [...fx.querySelectorAll('.ripple,.spark')].forEach(n => n.remove());
  fn(); void stage.offsetWidth;
  stage.classList.remove('snap');
}

/* ---------- geometry / cursor ---------- */
function pos(el) {
