  const x = (r.left - s.left) / scale, y = (r.top - s.top) / scale, w = r.width / scale, h = r.height / scale;
  return { x, y, w, h, cx: x + w / 2, cy: y + h / 2 };
}
const cx = $('#cx'), cy = $('#cy'), cursor = $('#cursor');
let cur = { x: 1500, y: 900 };
function curSet(x, y, vis) {
