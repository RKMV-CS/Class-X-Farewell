/* ---------- audio (synthesized, no files) ---------- */
let AC = null;
function audio() {
  if (!C.audio.enabled) return null;
  try { if (!AC) AC = new (window.AudioContext || window.webkitAudioContext)(); if (AC.state === 'suspended') AC.resume(); } catch (e) { AC = null; }
  return AC;
}
function blip() {
  const ac = audio(); if (!ac) return; const t = ac.currentTime;
  const o = ac.createOscillator(), g = ac.createGain();
  o.type = 'sine'; o.frequency.setValueAtTime(900, t); o.frequency.exponentialRampToValueAtTime(420, t + .08);
  g.gain.setValueAtTime(.0001, t); g.gain.exponentialRampToValueAtTime(.07, t + .005); g.gain.exponentialRampToValueAtTime(.0001, t + .12);
  o.connect(g); g.connect(ac.destination); o.start(t); o.stop(t + .15);
}
function sting() {
  const ac = audio(); if (!ac) return; const t = ac.currentTime + .02;
  const master = ac.createGain(); master.gain.value = .55;
  const comp = ac.createDynamicsCompressor(); master.connect(comp); comp.connect(ac.destination);
  const tone = (f, st, dur, type, vol) => {
    const o = ac.createOscillator(), g = ac.createGain(); o.type = type; o.frequency.value = f;
    g.gain.setValueAtTime(.0001, t + st); g.gain.exponentialRampToValueAtTime(vol, t + st + .012); g.gain.exponentialRampToValueAtTime(.0001, t + st + dur);
    o.connect(g); g.connect(master); o.start(t + st); o.stop(t + st + dur + .05);
  };
  [523.25, 659.25, 783.99, 1046.5, 1318.5].forEach((f, i) => { tone(f, i * .07, .9, 'triangle', .22); tone(f * 2, i * .07, .5, 'sine', .05); });
  [261.63, 523.25, 659.25, 783.99, 1046.5].forEach(f => tone(f, .42, 1.9, 'triangle', .12));
  const o = ac.createOscillator(), g = ac.createGain(); o.type = 'sine';
  o.frequency.setValueAtTime(150, t); o.frequency.exponentialRampToValueAtTime(46, t + .4);
  g.gain.setValueAtTime(.0001, t); g.gain.exponentialRampToValueAtTime(.7, t + .01); g.gain.exponentialRampToValueAtTime(.0001, t + .6);
  o.connect(g); g.connect(master); o.start(t); o.stop(t + .7);
  const len = Math.floor(ac.sampleRate * .9), buf = ac.createBuffer(1, len, ac.sampleRate), d = buf.getChannelData(0);
  for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1);
  const ns = ac.createBufferSource(); ns.buffer = buf;
  const bp = ac.createBiquadFilter(); bp.type = 'bandpass'; bp.Q.value = 1.2;
  bp.frequency.setValueAtTime(2500, t + .3); bp.frequency.exponentialRampToValueAtTime(9000, t + 1.1);
  const ng = ac.createGain(); ng.gain.setValueAtTime(.0001, t + .3); ng.gain.exponentialRampToValueAtTime(.09, t + .4); ng.gain.exponentialRampToValueAtTime(.0001, t + 1.2);
  ns.connect(bp); bp.connect(ng); ng.connect(master); ns.start(t + .3); ns.stop(t + 1.25);
}

